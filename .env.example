# Backend security and service locations (replace blank values in deployment)
SIH_SECRET_KEY=
# Production: set the actual ML HTTPS base URL, without /api or a trailing path.
# Local development only: SIH_ML_BACKEND=http://127.0.0.1:8000
SIH_ML_BACKEND=
SIH_DB_PATH=/absolute/persistent/path/animal_health.db
APP_BASE_URL=http://localhost:5001

# Official helpline. Application startup rejects any other number.
IVR_PHONE_NUMBER=7382210251
IVR_PROVIDER_MODE=MOCK
IVR_WEBHOOK_SECRET=
IVR_PSTN_CONNECTED=false
# Set only after the full real-mobile PSTN acceptance test has passed.
IVR_PSTN_VERIFIED_AT=
IVR_RATE_LIMIT_PER_MINUTE=60
IVR_DUPLICATE_WINDOW_HOURS=48

# Veterinarian routing
VET_WORK_START_HOUR=0
VET_WORK_END_HOUR=24
VET_MAX_ACTIVE_CASES=25
VET_LIVE_CALL_STALE_MINUTES=30
IVR_ALLOW_OUTSIDE_HOURS_FALLBACK=false

# ---------------------------------------------------------------- SMS gateway
# Android SMS Gateway (capcom6) — used to deliver farmer login OTPs.
# Cloud Server mode:  https://api.sms-gate.app/3rdparty/v1
# Local Server mode:  http://<android-device-ip>:8080
# MOCK simulates delivery for local development only and is refused when
# RENDER/FLASK_ENV marks the process as production.
SMS_GATEWAY_MODE=CLOUD
# Cloud:  https://api.sms-gate.app/3rdparty/v1   (client posts to /messages)
# A bare https://api.sms-gate.app is also accepted and normalised.
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Strongly recommended: pin the handset that must send the OTPs. Without it the
# cloud server picks a device at random from the account (documented
# multi-device behaviour), so a stale second phone can swallow the dispatch.
# List devices: curl -u "$SMS_GATEWAY_USERNAME:$SMS_GATEWAY_PASSWORD" \
#   https://api.sms-gate.app/3rdparty/v1/devices
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_TIMEOUT=15
# TCP connect timeout (seconds); keeps a hung connect from blocking a worker.
SMS_GATEWAY_CONNECT_TIMEOUT=5
# Optional documented fields — leave blank to omit them from the request.
SMS_GATEWAY_SIM_NUMBER=
# Recommended for OTPs: TTL=300 (drop stale codes) and PRIORITY=100 (bypass the
# Android device's delay/rate-limit queue).
SMS_GATEWAY_TTL_SECONDS=
SMS_GATEWAY_PRIORITY=
# Set to true only for a trusted LAN with an http:// local server URL.
SMS_GATEWAY_ALLOW_INSECURE=false
# Notification SMS provider for the existing queue: MOCK | TWILIO | GATEWAY
SMS_PROVIDER_MODE=MOCK

# ------------------------------------------------------- farmer OTP login
# Server-side pepper for OTP hashes. Falls back to SIH_SECRET_KEY when unset;
# set it explicitly so OTPs survive a restart and a DB leak alone is useless.
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MOBILE_MAX_REQUESTS=5
OTP_MOBILE_RATE_WINDOW_SECONDS=900
OTP_IP_MAX_REQUESTS=20
OTP_IP_RATE_WINDOW_SECONDS=3600
# DEV ONLY: print MOCK-mode OTPs to the server log (ignored in production).
OTP_DEV_PRINT_CODE=false
# Shared secret for GET /api/admin/otp-diagnostics (delivery/verification
# tracing). Government JWTs are accepted as well. Keep it in Render only.
OTP_DIAG_TOKEN=
# Farmer authentication is OTP-only: there is no password fallback to configure.
# Vet / Government / Laboratory keep the original password login.
# Lifetime of the OTP-verified farmer signup token (seconds).
OTP_REGISTRATION_TOKEN_TTL_SECONDS=900

# ------------------------------------------- farmer phone OTP via Clerk
# When both keys are set, farmer login/signup OTPs are sent and checked by Clerk
# (no SMS gateway phone needed); the SMS gateway settings above become unused
# for farmer login. Leave blank to keep the SMS gateway flow. See CLERK_PHONE_LOGIN.md.
# Get them at https://dashboard.clerk.com -> your app -> Configure -> API keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: comma-separated origins allowed to mint tokens (session `azp`).
# CLERK_AUTHORIZED_PARTIES=https://pashu-mitra-smoky.vercel.app

# ------------------------------------------------- prototype demo account
# A "Demo Account" box on the FARMER login screen with a fixed OTP, for
# prototype demonstrations that must not depend on real SMS delivery.
# OFF by default. Read on every request — no restart needed.
#   DEMO_MODE=false                 the shipped default: nothing changes.
#   DEMO_MODE=true                  enables the box and the fixed OTP.
# A process that looks like production (RENDER, or FLASK_ENV/APP_ENV=production)
# needs a SECOND explicit opt-in, so a public deployment can never switch on a
# universal fixed OTP by accident:
#   DEMO_MODE_ALLOW_PRODUCTION=true
# Turn BOTH back to false before any public production use. See DEMO_ACCOUNT.md.
DEMO_MODE=false
DEMO_MODE_ALLOW_PRODUCTION=false
# The demo farmer's number and fixed OTP (shown on the login screen while demo
# mode is on). They are prototype configuration, not secrets; they are rejected
# by the ordinary authentication rules whenever DEMO_MODE is false.
DEMO_FARMER_MOBILE=8341564042
DEMO_FARMER_OTP=123456
# Optional profile shown in the demo farmer's account.
DEMO_FARMER_NAME=Demo Farmer
DEMO_FARMER_DISTRICT=Pune
# DEMO_FARMER_VILLAGE=Demo Village
# DEMO_FARMER_BLOCK=Haveli

# Existing weather integration
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Optional ML service overrides. Blank ML_MODEL_DIR uses ml-backend/models;
# relative values are resolved against ml-backend, not the working directory.
ML_MODEL_DIR=
# Not required for Flask -> ML traffic; set trusted origins only for direct browser calls.
ML_CORS_ORIGINS=

# --------------------------------------------------- real-time web calling
# Farmer <-> veterinarian WebRTC audio inside the existing portals. The Flask
# service is the only signaling authority (Flask-SocketIO + the REST endpoints
# below); there is no third-party signaling service.
#
# Ring timeout before an unanswered call becomes "missed" (seconds, 10-180).
SIH_WEBCALL_RING_TIMEOUT_SECONDS=45
# Sweeper: expires abandoned/stale calls in the background (leave on in
# production; the unit tests turn it off to control time explicitly).
SIH_WEBCALL_SWEEPER=true
# Minutes after which an untouched call row is force-closed by the sweeper.
SIH_WEBCALL_ABANDON_MINUTES=45
# Deliver Web Push synchronously inside the request that answers a farmer's
# call (default). Set to 0 to skip push in-process; a separate worker/sweeper
# then owns delivery.
SIH_WEBCALL_PUSH_SYNC=1

# STUN: used for NAT discovery. Comma-separated URLs. Deep-link defaults are
# public Google STUN servers; replace them with your own if you prefer.
SIH_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN: REQUIRED for calls where both peers are behind symmetric NAT/mobile
# carrier CGNAT. Without TURN those calls end in an honest "could not connect".
# Never hardcode credentials in the frontend: the browser only receives the ICE
# response from /api/webcall/config.
#
# Supported modes:
#   1) Preferred coturn REST-secret mode (ephemeral per-user credentials)
#      SIH_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349
#      SIH_TURN_SECRET=<coturn static-auth-secret>
#      SIH_TURN_TTL_SECONDS=3600
#   2) Static managed TURN mode (for example Metered)
#      SIH_TURN_URLS=["turn:global.relay.metered.ca:80","turn:global.relay.metered.ca:80?transport=tcp"]
#      SIH_TURN_USERNAME=<provider username>
#      SIH_TURN_CREDENTIAL=<provider credential>
# Do not set SIH_TURN_SECRET for a provider that only supports static creds.
SIH_TURN_URLS=
SIH_TURN_SECRET=
SIH_TURN_TTL_SECONDS=3600
SIH_TURN_USERNAME=
SIH_TURN_CREDENTIAL=
# "relay" forces every candidate through TURN (useful for testing a TURN-only
# path; costs relay bandwidth for every call). "all" is the normal setting.
SIH_ICE_TRANSPORT_POLICY=all

# --- cross-worker signaling -------------------------------------------------
# Socket.IO connections are pinned to one Gunicorn worker. Rooms/emits do not
# cross workers by themselves; the shared SQLite web_call_signals table is the
# cross-worker authority (clients reconcile missed signals over REST), and a
# Redis message queue removes the fan-out delay between workers.
SIH_REDIS_URL=
# Gunicorn worker count (must match the start command). The signalling socket
# and the code that emits call events must live in one process, so the deployed
# value is 1 together with a threaded worker:
#   gunicorn app:app --worker-class gthread --workers 1 --threads 100
# Raising this without SIH_REDIS_URL breaks real-time delivery; this variable
# only makes the server log that warning.
SIH_GUNICORN_WORKERS=1
# Public URL of this Flask service when the browser talks to it directly (for
# example the Render URL). REQUIRED for a split Vercel frontend + Render backend
# because WebSocket signaling must connect directly to Render; the Vercel /api
# rewrite can continue to proxy ordinary REST requests. Leave blank only for
# same-origin/local development.
SIH_PUBLIC_BACKEND_URL=
# Comma-separated browser origins allowed to open the signaling socket. Required
# whenever the portal is served from a different origin than this API.
SIH_ALLOWED_ORIGINS=https://pashu-mitra-smoky.vercel.app
# Socket.IO endpoint path (keep in sync with frontend/vercel.json + call.js).
SIH_SOCKETIO_PATH=socket.io

# --- Web Push (incoming call while the vet is not looking at the portal) ----
# Generate once with: python -c "from py_vapid import Vapid01; print(...)"
# or `npx web-push generate-vapid-keys`. Placeholders only — never commit keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.org
