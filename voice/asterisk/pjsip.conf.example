; Copy into the PBX secret-management workflow and replace every placeholder.
; Never commit live carrier credentials.
[global]
type=global
user_agent=Pashu-Shield-PBX

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
cert_file=/etc/asterisk/keys/pbx.crt
priv_key_file=/etc/asterisk/keys/pbx.key
method=tlsv1_2

[carrier-auth]
type=auth
auth_type=userpass
username=${CARRIER_SIP_USERNAME}
password=${CARRIER_SIP_PASSWORD}

[carrier-aor]
type=aor
contact=sip:${CARRIER_SIP_HOST}:5061
qualify_frequency=60

[carrier-trunk]
type=endpoint
transport=transport-tls
context=pashu-carrier-inbound
disallow=all
allow=alaw,ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
outbound_auth=carrier-auth
aors=carrier-aor
from_domain=${CARRIER_SIP_HOST}

[carrier-identify]
type=identify
endpoint=carrier-trunk
match=${CARRIER_SIGNALING_CIDR}
